+// Replace all invalid characters with '_' to prevent silent save corruption.
+static void SanitizeFilenameForWindows(std::filesystem::path& path) {
+	auto str = Common::PathToGenericString(path);
+	bool changed = false;
+	for (auto& c : str) {
+		if (c == ':' || c == '<' || c == '>' || c == '"' || c == '|' || c == '?' || c == '*') {
+			c = '_';
+			changed = true;
+		}
+	}
+	if (changed) {
+		path = str;
+	}
+}
